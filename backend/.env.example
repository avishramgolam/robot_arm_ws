# Claude API key. With `ant auth login` configured, this can be left unset.
ANTHROPIC_API_KEY=

# Model + effort. Opus 5 default; effort "medium" balances answer quality vs
# chat latency (raise to "high" if eval quality demands it).
HEALTHGUIDE_MODEL=claude-opus-5
HEALTHGUIDE_EFFORT=medium

# PostgreSQL for the expert review queue. If unset, interactions are logged to
# ./review_queue.jsonl instead (dev mode) so the API still runs end-to-end.
DATABASE_URL=postgresql://user:pass@localhost:5432/healthguide

# Bearer token protecting /admin/* review endpoints and the dashboard.
ADMIN_TOKEN=change-me

# Days before logged interactions expire (privacy retention window).
LOG_RETENTION_DAYS=90
